<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEB3B"
        android:gravity="center"
        android:padding="8dp"
        android:text="Nhóm 10 - Bùi Nhật Tuấn"
        android:textColor="#F44336"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- HEADER -->
    <include
        android:id="@+id/layoutHeader"
        layout="@layout/layout_header" />

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TIỀN ĐIỆN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ TIỀN ĐIỆN"
                android:textColor="#FF9800"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập hạn mức Điện (VNĐ)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtElectricBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvElectricStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Đã dùng: 0đ / 0đ" />

            <ProgressBar
                android:id="@+id/progressElectric"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvElectricAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Trạng thái ổn định"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvElectricAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gợi ý: Tắt bớt điện..."
                android:textColor="#795548"
                android:textStyle="italic"
                android:visibility="gone" />

            <!-- TIỀN NƯỚC -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧 TIỀN NƯỚC"
                android:textColor="#2196F3"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập hạn mức Nước (VNĐ)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtWaterBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvWaterStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Đã dùng: 0đ / 0đ" />

            <ProgressBar
                android:id="@+id/progressWater"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvWaterAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Trạng thái ổn định"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvWaterAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gợi ý: Khóa vòi nước..."
                android:textColor="#795548"
                android:textStyle="italic"
                android:visibility="gone" />

            <!-- NÚT LƯU -->
            <Button
                android:id="@+id/btnSaveBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:text="Lưu Cấu Hình" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="#CCCCCC" />

            <!-- THỐNG KÊ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Lịch sử chi tiêu (6 tháng)"
                android:textSize="20dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E0E0E0"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tháng" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Điện" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nước" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBudgetHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
