<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">

    <!-- LOẠI HÓA ĐƠN -->
    <TextView
        android:id="@+id/tvLoai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hóa đơn tiền điện"
        android:textStyle="bold"
        android:textSize="20sp"/>

    <!-- NGÀY GIỜ -->
    <TextView
        android:id="@+id/tvNgayGio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:32:10 - 02/12/2025"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <!-- CHỈ SỐ -->
    <TextView
        android:id="@+id/tvChiSo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉ số đầu: 1200  -  Chỉ số cuối: 1450"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <!-- ĐƠN VỊ -->
    <TextView
        android:id="@+id/tvDonVi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="kWh / m³: 250"
        android:textSize="16sp"
        android:layout_marginTop="6dp"/>

    <!-- TỔNG TIỀN -->
    <TextView
        android:id="@+id/tvTongTien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tổng tiền: 935.000 đ"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"/>

    <!-- TRẠNG THÁI -->
    <TextView
        android:id="@+id/tvTrangThai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa thanh toán"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <!-- NHÓM NÚT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnSua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa"/>

        <Button
            android:id="@+id/btnXoa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa"
            android:layout_marginStart="8dp"/>

        <Button
            android:id="@+id/btnDong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đóng"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
